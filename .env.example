# GitHub OAuth app credentials (never expose the secret in client code)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate with: npx auth@latest secret
AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Local AI provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# SQLite for development. Change the Prisma provider for a later PostgreSQL migration.
DATABASE_URL=file:./dev.db
